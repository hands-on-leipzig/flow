APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Vanity host for public event links (QR, DRAHT). Unset: derived from APP_ENV / FRONTEND_URL.
#   Production → https://handson.tools
#   Test       → https://test.handson.tools
#   Dev        → https://dev.handson.tools
#   Laptop     → FRONTEND_URL (http://localhost:5173)
# Legacy PUBLIC_URL=https://handson.tools/dev|/test is rewritten to the subdomains.
# PUBLIC_URL=https://dev.handson.tools

# SPA origin (QR, public pages). Cloud: the public FLOW host for that env
# (https://dev.flow.hands-on-technology.org / test / flow.hands-on-technology.org).
# FRONTEND_URL=http://localhost:5173

# Chromium print (Übersichtsplan). Same keys locally and on every cloud .env.
# Local (PHP + Vite on the host, Gotenberg in Docker, no auth):
#   docker compose up -d gotenberg
#   GOTENBERG_URL=http://127.0.0.1:3000
#   PRINT_PAGE_BASE_URL=http://host.docker.internal:5173
# Laravel inside docker-compose instead: GOTENBERG_URL=http://gotenberg:3000
# Cloud on the FLOW VM (loopback Gotenberg — needs Docker on that host):
#   GOTENBERG_URL=http://127.0.0.1:3000
# Remote Gotenberg (Traefik on another VM), Basic Auth:
#   GOTENBERG_URL=https://gotenberg.example.org
#   GOTENBERG_USERNAME=flow
#   GOTENBERG_PASSWORD=
# PRINT_PAGE_BASE_URL unset → Chromium opens FRONTEND_URL
# If the VM cannot hairpin its public hostname, set PRINT_PAGE_BASE_URL to
# http://host.docker.internal (nginx on the host).
# GOTENBERG_URL=
# GOTENBERG_USERNAME=
# GOTENBERG_PASSWORD=
# PRINT_PAGE_BASE_URL=
# GOTENBERG_TIMEOUT=90

# Geocoding (OpenStreetMap Nominatim) for the venue map and the teams map slide.
# Nominatim allows one request per second; lower the interval only for a private instance.
# NOMINATIM_URL=https://nominatim.openstreetmap.org/search
# NOMINATIM_MIN_INTERVAL=1.1
# NOMINATIM_COUNTRYCODES=de
# NOMINATIM_TIMEOUT=8

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Do not set for normal `php artisan serve` (Laravel warns: use `php artisan serve --no-reload` if you need workers).
# Übersichtsplan PDF needs workers locally (Chromium calls /api while Laravel waits on Gotenberg):
#   PHP_CLI_SERVER_WORKERS=4 php artisan serve --no-reload
# PHP_CLI_SERVER_WORKERS=4
# Increase for long-running requests (e.g. plan generation) in local dev; default 30
# MAX_EXECUTION_TIME=300

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Product mail via Microsoft Graph sendMail (dedicated Entra app, Mail.Send).
# Without credentials, switch to MAIL_MAILER=log.
MAIL_MAILER=microsoft-graph
MAIL_FROM_ADDRESS=noreply@example.org
MAIL_FROM_NAME="FLOW - HANDS on TECHNOLOGY"
MICROSOFT_GRAPH_TENANT_ID=
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_CLIENT_SECRET=
# MAIL_SAVE_TO_SENT_ITEMS=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
